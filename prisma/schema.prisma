generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SUPER_ADMIN has unrestricted access everywhere ADMIN does (see requireRole in
// server/middleware/auth.js) and is meant to stay a single fixed account (see prisma/seed.js) —
// it's never selectable in the regular user create/edit UI (src/admin/pages/UsersPage.jsx).
// ADMIN and STAFF each have a super-admin-configurable, sidebar-visibility-only menu list
// (Setting.adminMenuKeys/staffMenuKeys) — see src/admin/menuConfig.js.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CLIENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Discriminates the audit-trail entries on TicketActivity — kept as an enum (rather than a
// free-text "type" string) so field-change vs. lifecycle rows stay easy to branch on in the UI.
enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
}

enum ProjectStatus {
  PROPOSED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ProjectBillingType {
  MILESTONE
  HOURLY
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  SOFTWARE_TOOLS
  EQUIPMENT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum BusinessExpenseCategory {
  GST
  SERVER
  DOMAIN
  SALARY
  SOFTWARE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUALIFIED
  WON
  LOST
}

enum EmailTemplateCategory {
  TICKET
  INVOICE
  QUOTATION
  TIMESHEET
  EXPENSE
  ENQUIRY
  LICENSE
  FORUM
}

enum ForumUserStatus {
  ACTIVE
  BANNED
}

enum EmailStatus {
  SENT
  FAILED
}

enum WhatsAppStatus {
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  // Personal WhatsApp number for ticket notifications (new ticket, client reply) — distinct
  // from UserWhatsAppSettings.phoneNumberId, which is a Meta API identifier for sending, not
  // a dialable number. Self-service, set from Settings > My WhatsApp.
  whatsappNumber String?

  createdClients    Client[]          @relation("ClientCreatedBy")
  createdProjects   Project[]         @relation("ProjectCreatedBy")
  recordedPayments  Payment[]         @relation("PaymentRecordedBy")
  createdQuotations Quotation[]       @relation("QuotationCreatedBy")
  createdInvoices   Invoice[]         @relation("InvoiceCreatedBy")
  timesheets        Timesheet[]
  expenseClaims     ExpenseClaim[]    @relation("ExpenseClaimant")
  approvedExpenses  ExpenseClaim[]    @relation("ExpenseApprovedBy")
  businessExpenses  BusinessExpense[] @relation("BusinessExpenseCreatedBy")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdTickets    Ticket[]           @relation("TicketCreatedBy")
  assignedTickets   Ticket[]           @relation("TicketAssignedTo")
  ticketActivities  TicketActivity[]   @relation("TicketActivityActor")
  ticketMessages    TicketMessage[]
  ticketAttachments TicketAttachment[]

  createdLeads  Lead[]     @relation("LeadCreatedBy")
  assignedLeads Lead[]     @relation("LeadAssignedTo")
  leadCalls     LeadCall[]

  whatsappSettings UserWhatsAppSettings?

  whatsappConversations WhatsAppConversation[]
  sentWhatsAppMessages  WhatsAppMessage[]
  chatFlows             ChatFlow[]

  // Staff/admin can answer public forum questions using their existing admin_session login —
  // see server/middleware/forumAuth.js dual-auth helper. Distinct from ForumAnswer.authorForumUserId.
  forumAnswers     ForumAnswer[]
  forumAttachments ForumAttachment[]

  // Set only for CLIENT-role logins that have used "Log in with your client account" on the
  // forum — see ForumUser.linkedUserId above.
  linkedForumUser ForumUser?

  @@map("users")
}

// Per-user Meta WhatsApp Business API credentials (ADMIN/STAFF self-service, distinct from the
// single global Setting.whatsapp* block used for ticket notifications) — each staff member can
// send from their own WhatsApp Business number. accessToken is encrypted at rest (server/crypto.js);
// accessTokenLast4 exists purely so the settings UI can show a masked value without ever decrypting.
model UserWhatsAppSettings {
  id                   String   @id @default(cuid())
  phoneNumberId        String
  accessTokenEncrypted String
  accessTokenLast4     String?
  webhookVerifyToken   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_whatsapp_settings")
}

// ---------- WhatsApp conversation inbox + chatbot flow builder ----------
// One WhatsAppConversation per (owning user, contact number) — inbound/outbound message thread.
// Scoped generically per-user (like UserWhatsAppSettings) even though only ADMIN uses it today.

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  INTERACTIVE
  OTHER
}

model WhatsAppConversation {
  id                 String   @id @default(cuid())
  contactNumber      String
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  messages     WhatsAppMessage[]
  flowSessions ChatFlowSession[]

  @@unique([userId, contactNumber])
  @@index([userId, lastMessageAt])
  @@map("whatsapp_conversations")
}

// metaMessageId dedups against Meta's webhook retries and correlates later status callbacks
// (SENT/DELIVERED/READ/FAILED) back to the outbound message that was sent.
model WhatsAppMessage {
  id            String                   @id @default(cuid())
  direction     WhatsAppMessageDirection
  messageType   WhatsAppMessageType      @default(TEXT)
  body          String?
  rawPayload    Json?
  metaMessageId String?                  @unique
  sentByBot     Boolean                  @default(false)
  status        String?
  createdAt     DateTime                 @default(now())

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentByUserId String?
  sentByUser   User?   @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

enum ChatFlowTriggerType {
  ANY_MESSAGE
  KEYWORD
}

enum ChatFlowNodeType {
  MESSAGE
  QUESTION
  CONDITION
  END
}

model ChatFlow {
  id              String              @id @default(cuid())
  name            String
  isActive        Boolean             @default(false)
  archivedAt      DateTime?
  triggerType     ChatFlowTriggerType @default(ANY_MESSAGE)
  triggerKeywords String[]            @default([])
  startNodeId     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  nodes    ChatFlowNode[]
  edges    ChatFlowEdge[]
  sessions ChatFlowSession[]

  @@index([userId, isActive])
  @@map("chat_flows")
}

// data shape varies by type — MESSAGE:{message}; QUESTION:{message,variableName};
// CONDITION:{conditions:[{matchType,value,nextNodeId}],defaultNextNodeId}; END:{}
model ChatFlowNode {
  id        String           @id @default(cuid())
  type      ChatFlowNodeType
  data      Json
  positionX Float
  positionY Float

  flowId String
  flow   ChatFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("chat_flow_nodes")
}

model ChatFlowEdge {
  id         String  @id @default(cuid())
  fromNodeId String
  toNodeId   String
  label      String?

  flowId String
  flow   ChatFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("chat_flow_edges")
}

enum ChatFlowSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

// No unique constraint on conversationId — a contact can complete one flow and trigger another
// later; history is kept, not overwritten. "At most one ACTIVE session per conversation" is an
// application invariant enforced by chatFlowEngine.js under an advisory lock, not a DB constraint.
model ChatFlowSession {
  id            String                @id @default(cuid())
  currentNodeId String?
  variables     Json                  @default("{}")
  status        ChatFlowSessionStatus @default(ACTIVE)
  startedAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  flowId String
  flow   ChatFlow @relation(fields: [flowId], references: [id], onDelete: Restrict)

  @@index([conversationId, status])
  @@map("chat_flow_sessions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  gstNumber String?
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  projects              Project[]
  quotations            Quotation[]
  invoices              Invoice[]
  users                 User[]
  tickets               Ticket[]
  whatsappConversations WhatsAppConversation[]

  @@map("clients")
}

model Project {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus      @default(PROPOSED)
  billingType ProjectBillingType @default(MILESTONE)
  hourlyRate  Decimal?           @db.Decimal(12, 2)
  totalValue  Decimal            @default(0) @db.Decimal(12, 2)
  currency    String             @default("INR")
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime           @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  payments      Payment[]
  quotations    Quotation[]
  invoices      Invoice[]
  milestones    ProjectMilestone[]
  timesheets    Timesheet[]
  expenseClaims ExpenseClaim[]
  tickets       Ticket[]

  @@map("projects")
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  sequence    Int             @default(0)
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  invoices Invoice[]

  @@map("project_milestones")
}

model Timesheet {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  hours           Decimal  @db.Decimal(5, 2)
  taskDescription String
  billable        Boolean  @default(true)
  createdAt       DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@map("timesheets")
}

model ExpenseClaim {
  id               String          @id @default(cuid())
  category         ExpenseCategory @default(OTHER)
  amount           Decimal         @db.Decimal(12, 2)
  expenseDate      DateTime        @default(now())
  description      String
  status           ExpenseStatus   @default(PENDING)
  approvedAt       DateTime?
  reimbursedAt     DateTime?
  reimbursedAmount Decimal?        @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())

  userId String
  user   User   @relation("ExpenseClaimant", fields: [userId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  @@map("expense_claims")
}

// Recurring/one-off business overheads (GST, hosting, domains, salaries paid out) —
// distinct from ExpenseClaim, which is employee reimbursement requests.
model BusinessExpense {
  id          String                  @id @default(cuid())
  category    BusinessExpenseCategory @default(OTHER)
  amount      Decimal                 @db.Decimal(12, 2)
  paidOn      DateTime                @default(now())
  paidTo      String?
  description String?
  createdAt   DateTime                @default(now())

  createdById String?
  createdBy   User?   @relation("BusinessExpenseCreatedBy", fields: [createdById], references: [id])

  @@map("business_expenses")
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  paidOn    DateTime      @default(now())
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@map("payments")
}

model Quotation {
  id              String             @id @default(cuid())
  quotationNumber String             @unique
  issueDate       DateTime           @default(now())
  validUntil      DateTime?
  subject         String?
  billingType     ProjectBillingType @default(MILESTONE)
  items           Json
  discount        Decimal            @default(0) @db.Decimal(12, 2)
  notes           String?
  terms           String?
  scopeOfWork     String?
  outOfScope      String?
  assumptions     String?
  revisionPolicy  String?
  warrantyPeriod  String?
  ipOwnership     String?
  techStack       String?
  status          QuotationStatus    @default(DRAFT)
  currency        String             @default("INR")
  createdAt       DateTime           @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  invoices Invoice[]

  @@map("quotations")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  items         Json
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  terms         String?
  tdsApplicable Boolean       @default(false)
  tdsRate       Decimal       @default(10.00) @db.Decimal(5, 2)
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("INR")
  createdAt     DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  createdById String?
  createdBy   User?   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  payments Payment[]

  licenseRequest LicenseRequest?

  @@map("invoices")
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  ccEmails     String[]       @default([])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  resolvedAt   DateTime?
  closedAt     DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  messages    TicketMessage[]
  attachments TicketAttachment[]
  activities  TicketActivity[]

  @@map("tickets")
}

// Audit trail shown on the ticket detail page's "Activity" tab, separate from the
// client-facing TicketMessage comment thread — mirrors Jira's Comments/History split.
model TicketActivity {
  id        String             @id @default(cuid())
  type      TicketActivityType
  field     String? // e.g. "status", "priority", "assignedTo" — null for CREATED
  oldValue  String?
  newValue  String?
  createdAt DateTime           @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  actorId String
  actor   User   @relation("TicketActivityActor", fields: [actorId], references: [id])

  @@map("ticket_activities")
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  attachments TicketAttachment[]

  @@map("ticket_messages")
}

model TicketAttachment {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@map("ticket_attachments")
}

// Single-row table (id is always "singleton") holding admin-configurable settings
// that would otherwise require an .env edit + redeploy to change.
model Setting {
  id                 String  @id @default("singleton")
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean @default(false)
  smtpUser           String?
  smtpPass           String?
  emailFrom          String?
  ticketNotifyEmail  String?
  enquiryNotifyEmail String?
  enquiryReplyTo     String?
  forumNotifyEmail   String?

  // Business profile used as the "seller" on invoice/quotation PDFs — previously only
  // stored client-side in localStorage, so it didn't survive across machines/browsers.
  businessName          String?
  businessContactPerson String?
  businessAddress       String?
  businessPhone         String?
  businessGst           String?
  bankName              String?
  bankAccountNumber     String?
  bankIfsc              String?
  upiId                 String?
  logoUrl               String?

  // WhatsApp Cloud API (Meta) — mirrors the SMTP block above. Outbound messages must use a
  // pre-approved Message Template (see WhatsAppTemplate), so there's no "body" to store here.
  whatsappEnabled           Boolean @default(false)
  whatsappPhoneNumberId     String?
  whatsappAccessToken       String?
  whatsappBusinessAccountId String?
  whatsappApiVersion        String?
  whatsappStaffNotifyNumber String?

  // Sidebar-visibility-only menu selection for ADMIN/STAFF, configured by SUPER_ADMIN
  // (src/admin/pages/SettingsPage.jsx "Menu Access" tab). Empty array means "not configured yet
  // — show everything" (see src/admin/components/AdminLayout.jsx), so this never locks anyone
  // out of a menu just because it was never explicitly set. SUPER_ADMIN always sees every menu
  // regardless of these lists — they aren't restrictable by this mechanism.
  adminMenuKeys String[] @default([])
  staffMenuKeys String[] @default([])

  // Offline (desktop) license fulfillment — see server/licenseApi.js and
  // src/pages/MedoraOfflinePage.jsx. Signing runs in-process using server/license-private.pem,
  // no API URL/key needed. Empty prices/URL mean "not configured yet" — the public page shows
  // a fallback instead of ₹0.
  licenseDownloadUrl     String?
  licenseInstallGuideUrl String?
  licensePlan3MoPrice    Int?
  licensePlan6MoPrice    Int?
  licensePlan1YrPrice    Int?

  // Razorpay — razorpayKeySecret/razorpayWebhookSecret follow the same plaintext-but-hidden
  // convention as smtpPass above (never returned by GET /admin/settings).
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayWebhookSecret String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  company         String?
  email           String?
  phone           String?
  source          String?
  status          LeadStatus @default(NEW)
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdById  String?
  createdBy    User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  calls                 LeadCall[]
  whatsappConversations WhatsAppConversation[]
  licenseRequest        LicenseRequest?

  @@map("leads")
}

enum LicensePlan {
  THREE_MONTH
  SIX_MONTH
  ONE_YEAR
}

enum LicenseRequestStatus {
  PENDING
  FULFILLED
  FAILED
}

// Standalone license-fulfillment record, managed from the admin Licenses section (Support area,
// ADMIN + STAFF). Created either automatically alongside a Lead (public
// /api/offline-license/subscribe form) or manually by staff (e.g. a phone/WhatsApp order —
// no Lead involved). Fulfilled via server/licenseFulfillment.js (mintLicense/emailLicense),
// which sign in-process (server/licenseApi.js) — either triggered manually from the admin
// Licenses page, or automatically from a verified Razorpay webhook once payment clears.
model LicenseRequest {
  id           String               @id @default(cuid())
  customerName String
  email        String
  whatsapp     String?
  businessName String?
  plan         LicensePlan
  machineId    String
  status       LicenseRequestStatus @default(PENDING)
  licenseId    String?
  fileContents String? // the signed license token itself — kept so it can be re-downloaded or
  // re-emailed without calling the license API again and minting a new one
  issuedAt     DateTime?
  expiresAt    DateTime?
  emailSentAt  DateTime? // generation no longer auto-sends — set only when the email actually
  // goes out, so the UI can show whether the customer has been emailed
  // yet, not just whether the license was minted.
  errorMessage String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Payment tracking — deliberately separate from `status` above, which means "has the
  // license been minted," not "has it been paid for." A verified Razorpay webhook is the only
  // thing allowed to flip paymentStatus to PAID (never trust a client-side payment callback).
  paymentStatus     PaymentStatus @default(UNPAID)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  amountPaid        Int? // rupees, same convention as licensePlan3MoPrice etc.
  paidAt            DateTime?

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Set once invoiceLicense() (server/licenseFulfillment.js) succeeds — guards against
  // minting a second, duplicate invoice if "Resend email" is clicked more than once.
  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("license_requests")
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model LeadCall {
  id              String    @id @default(cuid())
  calledAt        DateTime  @default(now())
  durationMinutes Int?
  notes           String
  followUpNeeded  Boolean   @default(false)
  followUpAt      DateTime?
  followUpDone    Boolean   @default(false)
  createdAt       DateTime  @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@map("lead_calls")
}

model EmailTemplate {
  id        String                @id @default(cuid())
  key       String                @unique
  category  EmailTemplateCategory
  label     String
  subject   String
  bodyHtml  String
  updatedAt DateTime              @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id           String      @id @default(cuid())
  to           String[]    @default([])
  cc           String[]    @default([])
  subject      String
  templateKey  String?
  relatedType  String?
  relatedId    String?
  status       EmailStatus
  errorMessage String?
  sentAt       DateTime    @default(now())

  @@map("email_logs")
}

// Which Meta-approved WhatsApp Message Template to use per notification key. Unlike
// EmailTemplate, the wording itself lives in Meta Business Manager, not here — this only
// records the registered template name + language so a send knows what to ask Meta for.
model WhatsAppTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  templateName String?
  language     String   @default("en_US")
  updatedAt    DateTime @updatedAt

  @@map("whatsapp_templates")
}

model WhatsAppLog {
  id           String         @id @default(cuid())
  to           String
  templateKey  String?
  status       WhatsAppStatus
  errorMessage String?
  relatedType  String?
  relatedId    String?
  sentAt       DateTime       @default(now())

  @@map("whatsapp_logs")
}

// ---------- Public Q&A forum ----------
// Self-service public accounts, deliberately NOT part of the `User` table (which is the
// staff/admin/CLIENT credentials table — every CLIENT login today is admin-provisioned via
// POST /admin/clients/:id/portal-user, there is no public self-registration elsewhere in this
// app). Kept on a separate model + separate session cookie (server/middleware/forumAuth.js) so a
// forum-issued JWT can never be mistaken for/accepted by admin/staff/client auth guards.
model ForumUser {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  status       ForumUserStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  lastLoginAt  DateTime?

  // Set the first time this client-portal login (User, role CLIENT) uses "Log in with your
  // client account" on the forum (server/routes/forum.js POST /client-login) — lets an existing
  // paying client post on the forum under their portal credentials without a separate forum
  // password. passwordHash above is a random, never-used value for these linked accounts; login
  // always goes through the linked User's credentials instead.
  linkedUserId String? @unique
  linkedUser   User?   @relation(fields: [linkedUserId], references: [id])

  questions   ForumQuestion[]
  answers     ForumAnswer[]
  attachments ForumAttachment[] @relation("ForumAttachmentUploadedByForumUser")

  @@map("forum_users")
}

model ForumCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  questions ForumQuestion[]

  @@map("forum_categories")
}

// Auto-published on create (no moderation queue) — hiddenAt/hiddenReason is how an admin takes
// down inappropriate content after the fact, set via PATCH /admin/forum/questions/:id.
model ForumQuestion {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  body         String
  viewCount    Int       @default(0)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorId String
  author   ForumUser @relation(fields: [authorId], references: [id])

  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id])

  // Set by the question author or any admin/staff member (POST /questions/:id/accept-answer/:answerId).
  acceptedAnswerId String?      @unique
  acceptedAnswer   ForumAnswer? @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)

  answers     ForumAnswer[]     @relation("QuestionAnswers")
  attachments ForumAttachment[]

  @@index([createdAt])
  @@index([categoryId])
  @@map("forum_questions")
}

// Answered by either a public ForumUser or internal staff (User) — exactly one of
// authorForumUserId/authorStaffUserId is set, enforced at the application layer (same
// optional-relation convention as LicenseRequest.leadId/invoiceId above).
model ForumAnswer {
  id           String    @id @default(cuid())
  body         String
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime  @default(now())

  questionId String
  question   ForumQuestion @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)

  authorForumUserId String?
  authorForumUser   ForumUser? @relation(fields: [authorForumUserId], references: [id])

  authorStaffUserId String?
  authorStaffUser   User?   @relation(fields: [authorStaffUserId], references: [id])

  acceptedFor ForumQuestion?    @relation("AcceptedAnswer")
  attachments ForumAttachment[]

  @@index([questionId, createdAt])
  @@map("forum_answers")
}

model ForumAttachment {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  questionId String?
  question   ForumQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerId String?
  answer   ForumAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  uploadedByForumUserId String?
  uploadedByForumUser   ForumUser? @relation("ForumAttachmentUploadedByForumUser", fields: [uploadedByForumUserId], references: [id])

  uploadedByStaffUserId String?
  uploadedByStaffUser   User?   @relation(fields: [uploadedByStaffUserId], references: [id])

  @@map("forum_attachments")
}
