# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
uploads

# Installer binaries — too large for git (100MB+); deploy these to the server's public/offline/
# directory directly (e.g. scp) rather than committing. The install guide PDF is small enough
# to track normally.
public/offline/*.exe

# License signing key — anyone with this can forge valid licenses for every customer. Never
# commit it. Deploy it out-of-band (scp) directly to wherever this server actually runs.
server/license-private.pem

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
